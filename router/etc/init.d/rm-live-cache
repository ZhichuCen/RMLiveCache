#!/bin/sh /etc/rc.common

START=18
STOP=89
USE_PROCD=1

ensure_lan_ip() {
    ip addr show dev br-lan 2>/dev/null | grep -q '192\.168\.8\.2/32' || ip addr add 192.168.8.2/32 dev br-lan
}

start_service() {
    ensure_lan_ip
    mkdir -p /tmp/rm-live-cache/segments
    /usr/lib/rm-live-cache/firewall.sh configure-dnsmasq
    /usr/lib/rm-live-cache/firewall.sh create
    /usr/lib/rm-live-cache/firewall.sh refresh

    procd_open_instance cache
    procd_set_param command /usr/bin/python3 /usr/lib/rm-live-cache/server.py
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param limits nofile="4096 4096"
    procd_close_instance

    procd_open_instance firewall_refresh
    procd_set_param command /bin/sh /usr/lib/rm-live-cache/firewall.sh run
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

reload_service() {
    ensure_lan_ip
}

stop_service() {
    /usr/lib/rm-live-cache/firewall.sh destroy
    ip addr del 192.168.8.2/32 dev br-lan >/dev/null 2>&1 || true
    rm -rf /tmp/rm-live-cache
}

service_triggers() {
    procd_add_reload_trigger "network"
}
